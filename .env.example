# Zero-key mode: hashing embeddings + mock LLM. Set to 0 to use real providers.
DEMO_MODE=1

# Chat (Anthropic)
ANTHROPIC_API_KEY=
# ANTHROPIC_BASE_URL=https://api.anthropic.com  # override for Anthropic-compatible servers
ANTHROPIC_MODEL=claude-sonnet-4-6

# Embeddings: openai | voyage (all vectors are 1024-d to match supabase/schema.sql)
EMBEDDINGS_PROVIDER=openai
OPENAI_API_KEY=
VOYAGE_API_KEY=

# Vector store: leave blank for in-memory (lost on restart / not shared across serverless instances)
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Crawler
CRAWL_TIMEOUT_MS=40000
ALLOW_PRIVATE_HOSTS=0
